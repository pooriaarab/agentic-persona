{
  "name": "agentic-persona",
  "version": "0.1.1",
  "description": "Define AI persona profiles, check brand voice and disclosure text, and build image, video, and caption prompts with a Node.js SDK, CLI, and MCP.",
  "keywords": [
    "ai-persona",
    "brand-voice",
    "content-checking",
    "ai-disclosure",
    "prompt-templates",
    "image-prompts",
    "video-prompts",
    "caption-prompts",
    "nodejs",
    "typescript",
    "cli",
    "mcp",
    "model-context-protocol",
    "zod"
  ],
  "license": "MIT",
  "author": "Pooria Arab",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pooriaarab/agentic-persona.git"
  },
  "type": "module",
  "private": false,
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "mcpName": "io.github.pooriaarab/agentic-persona",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "agentic-persona": "./dist/cli.js",
    "agentic-persona-mcp": "./dist/mcp-bin.js"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
